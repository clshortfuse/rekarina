// HDR10 encode on the present (runtime/vk_hdr.c vk_hdr_encode): linear Rec. 709 (HUD white at 1.0) into an RGBA16F
// image of PQ code values in Rec. 2020 that FSR 1 or the blit scale into the HDR10 swapchain.
// Steps: optional sRGB decode (UNORM sources), NaN guard, optional colour profile (vk_color.c), RenoDX gamma correction
// (2.2 or 2.4 power of the sRGB code), Rec. 709 -> Rec. 2020 conversion, RenoDX mid-grey gamut compression, HUD nits
// scaling, ratio-preserving peak clamp, and SMPTE ST 2084 PQ encode.
// p.x: nits of 1.0 (UI white), p.y: display peak in nits, p.z: 1 for UNORM sRGB decode, p.w: gamma correction
// (0 none, 1: 2.2, 2: 2.4).
// adj / q: colour profile (vk_color.c): q.x = 1 to grade, q.y = game white / UI white. q.z = 1: the picture's
// primaries are read as Display P3 (D65 white) instead of Rec. 709 (REKARINA_HDR_COLOR_SPACE, the global colour
// space of ShortFuse's RenoDX OoT mod), which spreads the game's colours over the wider P3 gamut.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba16f) uniform writeonly image2D dst;
layout(push_constant) uniform P {
    ivec2 offset;
    ivec2 size;
    vec4 p;
    vec4 adj;   // brightness (added), contrast, saturation, gamma (exponent)
    vec4 q;     // x: 1 to grade, y: the picture's white against 1.0, z: Display P3, w: guest transform
    vec4 guest_row[3]; // RGB → absolute Rec. 2020 nits, including the guest's white scale
} pc;

vec3 copy_sign(vec3 mag, vec3 s) {
    vec3 a = abs(mag);
    return mix(a, -a, lessThan(s, vec3(0.0)));
}

vec3 sign_pow(vec3 x, float e) { return copy_sign(pow(abs(x), vec3(e)), x); }

vec3 srgb_decode(vec3 c) {
    return mix(pow((c + 0.055) / 1.055, vec3(2.4)), c / 12.92, lessThanEqual(c, vec3(0.04045)));
}

vec3 srgb_encode(vec3 c) {   // c >= 0; continues above 1
    return mix(1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, c * 12.92, lessThanEqual(c, vec3(0.0031308)));
}

vec3 gamma_correct(vec3 c, float g) { return copy_sign(pow(srgb_encode(abs(c)), vec3(g)), c); }

vec3 grade(vec3 c) {
    vec3 e = srgb_encode(max(c, vec3(0.0)) / pc.q.y);
    e += pc.adj.x;
    e = (e - 0.5) * pc.adj.y + 0.5;
    e = mix(vec3(dot(e, vec3(0.2126, 0.7152, 0.0722))), e, pc.adj.z);
    e = pow(max(e, vec3(0.0)), vec3(pc.adj.w));
    return srgb_decode(e) * pc.q.y;
}

vec3 pq(vec3 nits) {
    const float m1 = 0.1593017578125, m2 = 78.84375, c1 = 0.8359375, c2 = 18.8515625, c3 = 18.6875;
    vec3 y = pow(clamp(nits / 10000.0, 0.0, 1.0), vec3(m1));
    return pow((c1 + c2 * y) / (1.0 + c3 * y), vec3(m2));
}

void main() {
    ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(at, pc.size))) return;
    vec3 c = texelFetch(src, at + pc.offset, 0).rgb;
    if (pc.q.w > 0.5) {
        vec3 nits;
        for (int i = 0; i < 3; ++i) {
            vec3 r = pc.guest_row[i].xyz;
            float v = fma(c.z, r.z, fma(c.x, r.x, c.y * r.y));
            nits[i] = pc.q.w > 1.5 ? max(v, 0.0) : abs(v);
        }
        vec3 y = pow(nits * 0.0001, vec3(0.1593017578125));
        vec3 code = pow(fma(y, vec3(18.8515625), vec3(0.8359375)) / fma(y, vec3(18.6875), vec3(1.0)), vec3(78.84375));
        imageStore(dst, at, vec4(mix(code, vec3(0.0), isnan(code)), 1.0));
        return;
    }
    if (pc.p.z > 0.5) c = srgb_decode(clamp(c, 0.0, 1.0));
    c = mix(c, vec3(0.0), isnan(c));
    if (pc.q.x > 0.5) c = grade(c);
    if (pc.p.w == 1.0) c = gamma_correct(c, 2.2);
    else if (pc.p.w == 2.0) c = gamma_correct(c, 2.4);
    // The picture's primaries to Rec. 2020 (rows): Rec. 709 (ITU-R BT.2087), or Display P3 with D65 white (both from
    // the primaries and the D65 white point)
    const mat3 BT709_TO_BT2020 = mat3(0.6274038960, 0.3292830384, 0.0433130657,
                                      0.0690972894, 0.9195403951, 0.0113623156,
                                      0.0163914388, 0.0880133078, 0.8955952532);
    const mat3 P3_TO_BT2020 = mat3(0.7538330344, 0.1985973691, 0.0475695966,
                                   0.0457438490, 0.9417772198, 0.0124789312,
                                   -0.0012103404, 0.0176017173, 0.9836086231);
    c = c * (pc.q.z > 0.5 ? P3_TO_BT2020 : BT709_TO_BT2020);
    float gray = dot(c, vec3(0.2627002120, 0.6779980715, 0.0593017165));
    const float MID_GRAY_GAMMA = log(1.0 / pow(10.0, 0.75)) / log(0.5);   // ~2.49: 18% grey encodes to 50%
    vec3 encoded = sign_pow(c, 1.0 / MID_GRAY_GAMMA);
    float encoded_gray = pow(max(gray, 0.0), 1.0 / MID_GRAY_GAMMA);
    float lowest = min(0.0, min(encoded.r, min(encoded.g, encoded.b)));
    float distance = encoded_gray - lowest;
    float ratio = distance == 0.0 ? 0.0 : -lowest / distance;
    c = sign_pow(mix(vec3(encoded_gray), encoded, 1.0 - ratio), MID_GRAY_GAMMA);
    c *= pc.p.x;
    float max_channel = max(max(max(c.r, c.g), c.b), pc.p.y);
    c *= pc.p.y / max_channel;
    imageStore(dst, at, vec4(pq(max(c, vec3(0.0))), 1.0));
}
