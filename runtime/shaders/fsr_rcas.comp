// AMD FidelityFX robust contrast-adaptive sharpening (RCAS)
// (runtime/vk_fsr.c). ffx/ffx_a.h and ffx/ffx_fsr1.h are AMD's headers, unmodified (MIT, ffx/LICENSE.txt).
#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D dst;

layout(push_constant) uniform Params {
    vec4 size;   // width, height, sharpness in stops (0 = most), mode (0: legacy, 1: linear, 2: linear via BT.2020)
} pc;

#define A_GPU 1
#define A_GLSL 1
#include "ffx/ffx_a.h"
#define FSR_RCAS_F 1
float scene_low, scene_span;
AF4 load_color(ASU2 p) { return texelFetch(src, clamp(p, ivec2(0), ivec2(pc.size.xy) - 1), 0); }
const mat3 to_2020 = mat3(0.627403896, 0.329283038, 0.043313066,
                         0.069097289, 0.919540396, 0.011362315,
                         0.016391439, 0.088013308, 0.895595253);
const mat3 to_709 = mat3(1.660491002, -0.587641139, -0.072849863,
                        -0.124550475, 1.132899897, -0.008349422,
                        -0.018150763, -0.100578898, 1.118729661);
AF3 working_rgb(AF3 c) { return pc.size.w == 2.0 ? c * to_2020 : c; }
AF3 signed_root(AF3 c) { return sign(c) * sqrt(abs(c)); }
AF4 FsrRcasLoadF(ASU2 p) {
    if (pc.size.w == 0.0) return texelFetch(src, p, 0);
    AF4 c = load_color(p);
    c.rgb = (signed_root(working_rgb(c.rgb)) - scene_low) / scene_span;
    return c;
}
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "ffx/ffx_fsr1.h"

void put(AU2 p, AU4 con) {
    if (p.x >= uint(pc.size.x) || p.y >= uint(pc.size.y)) return;
    bool scene = pc.size.w != 0.0;
    AF4 center;
    if (scene) {
        center = load_color(ASU2(p));
        // Keep the entire cross in RCAS's unit range without clipping signed or HDR scene values.
        const ASU2 offsets[4] = ASU2[4](ASU2(0, -1), ASU2(-1, 0), ASU2(1, 0), ASU2(0, 1));
        AF3 lo = working_rgb(center.rgb), hi = lo;
        for (int i = 0; i < 4; ++i) {
            AF3 neighbor = working_rgb(load_color(ASU2(p) + offsets[i]).rgb);
            lo = min(lo, neighbor);
            hi = max(hi, neighbor);
        }
        scene_low = -sqrt(max(0.0, -min(lo.r, min(lo.g, lo.b))));
        scene_span = sqrt(max(1.0, max(hi.r, max(hi.g, hi.b)))) - scene_low;
    }
    AF3 c;
    FsrRcasF(c.r, c.g, c.b, p, con);
    if (scene) {
        c = c * scene_span + scene_low;
        c *= abs(c);
        if (pc.size.w == 2.0) c = c * to_709;
        if (any(isnan(c)) || any(isinf(c))) c = center.rgb;
    }
    imageStore(dst, ivec2(p), vec4(c, scene ? center.a : 1.0));
}

void main() {
    AU4 con;
    FsrRcasCon(con, pc.size.z);
    AU2 p = ARmp8x8(gl_LocalInvocationID.x) + AU2(gl_WorkGroupID.x << 4u, gl_WorkGroupID.y << 4u);
    put(p, con);
    p.x += 8u;
    put(p, con);
    p.y += 8u;
    put(p, con);
    p.x -= 8u;
    put(p, con);
}
